
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Spacers Bénévoles — Version Bêta v2</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
:root {
  --blue:#185FA5;--bd:#0C447C;--bdd:#042C53;
  --bl:#E6F1FB;--bm:#B5D4F4;
  --g:#3B6D11;--gl:#EAF3DE;
  --a:#854F0B;--al:#FAEEDA;
  --gold:#C9821A;--goldl:#FEF3DC;
  --red:#993556;--redl:#FBEAF0;
  --pur:#533BB7;--purl:#EEEDFE;
  --wa:#25D366;--wal:#E8F9EF;
  --dk:#1a1a18;--md:#5F5E5A;--lt:#F1EFE8;--br:#D3D1C7;--bg:#F7F5F0;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
body{font-family:'Sora',sans-serif;background:#0C1B2E;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:16px;}
.frame{width:390px;height:780px;background:var(--bg);border-radius:44px;overflow:hidden;position:relative;box-shadow:0 40px 100px rgba(0,0,0,0.7),0 0 0 1px rgba(255,255,255,0.1);display:flex;flex-direction:column;}
.notch{height:14px;background:var(--bdd);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.notch-bar{width:80px;height:4px;background:rgba(0,0,0,0.4);border-radius:2px;}
.scr{display:none;flex-direction:column;flex:1;overflow:hidden;animation:fadeIn .25s ease;}
.scr.on{display:flex;}
@keyframes fadeIn{from{opacity:0;transform:translateX(14px);}to{opacity:1;transform:none;}}
.scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;}
.scroll::-webkit-scrollbar{display:none;}
.sbar{height:28px;background:var(--bdd);display:flex;align-items:center;justify-content:space-between;padding:0 18px;flex-shrink:0;}
.sbar-l{font-size:11px;font-weight:700;color:white;font-family:'JetBrains Mono',monospace;}
.sbar-r{font-size:10px;color:rgba(255,255,255,0.7);}
.tbar{background:var(--bd);padding:12px 18px;flex-shrink:0;}
.tbar-title{font-size:16px;font-weight:700;color:white;}
.tbar-sub{font-size:11px;color:var(--bm);margin-top:2px;}
.bnav{height:64px;background:white;border-top:1px solid var(--br);display:flex;align-items:center;flex-shrink:0;padding-bottom:4px;}
.bn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;cursor:pointer;padding:6px 0;border:none;background:none;font-family:'Sora',sans-serif;}
.bn-icon{font-size:18px;line-height:1;}
.bn-label{font-size:9px;color:var(--md);}
.bn.on .bn-label{color:var(--blue);font-weight:700;}
.card{background:white;border:1px solid var(--br);border-radius:16px;padding:14px;margin-bottom:10px;}
.sec-title{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--md);margin:14px 0 8px;}
.badge{display:inline-block;font-size:10px;padding:2px 8px;border-radius:50px;font-weight:600;}
.b-bl{background:var(--bl);color:var(--bd);}
.b-gr{background:var(--gl);color:var(--g);}
.b-am{background:var(--al);color:var(--a);}
.b-gd{background:var(--goldl);color:var(--gold);}
.b-rd{background:var(--redl);color:var(--red);}
.b-lt{background:var(--lt);color:var(--md);}
.b-wa{background:var(--wal);color:#128C7E;font-weight:700;}
.pill{font-size:11px;padding:5px 13px;border-radius:50px;border:1px solid var(--br);cursor:pointer;transition:all .15s;font-family:'Sora',sans-serif;}
.pill.on{background:var(--blue);color:white;border-color:var(--blue);}
.btn{padding:12px 20px;border-radius:50px;border:none;font-family:'Sora',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all .18s;}
.btn-p{background:var(--blue);color:white;}
.btn-g{background:var(--g);color:white;}
.btn-wa{background:var(--wa);color:white;}
.btn-s{background:var(--gl);color:var(--g);border:1px solid #C0DD97;}
.btn-full{width:100%;}
.btn:active{transform:scale(0.97);}
.prog-track{height:6px;background:var(--lt);border-radius:3px;overflow:hidden;}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--bd),var(--blue));border-radius:3px;}
.av{border-radius:50%;background:var(--blue);color:white;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}


.pilot-check{display:flex;gap:10px;align-items:start;padding:7px 0;border-bottom:1px solid var(--lt);cursor:pointer;}
.fb-chip{font-size:10px;padding:5px 11px;border-radius:50px;border:1.5px solid var(--br);background:var(--lt);color:var(--md);cursor:pointer;font-family:sans-serif;transition:all .15s;}
.fb-chip.on{background:var(--blue);color:white;border-color:var(--blue);}
.pilot-check:last-child{border:none;}
.pcheck-box{width:22px;height:22px;border-radius:6px;border:2px solid var(--br);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:transparent;flex-shrink:0;transition:all .15s;}
.pilot-check.done .pcheck-box{background:var(--g);border-color:var(--g);color:white;}
.pcheck-text{font-size:11px;color:var(--dk);line-height:1.5;}
.pilot-check.done .pcheck-text{text-decoration:line-through;color:var(--md);}
/* ══ LOGIN ══ */
#s-login{background:linear-gradient(160deg,var(--bdd) 0%,var(--bd) 60%,var(--blue) 100%);}
.login-body{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px 28px 16px;}
.login-logo{width:80px;height:80px;border-radius:24px;background:rgba(255,255,255,0.12);border:1.5px solid rgba(255,255,255,0.2);font-size:38px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;}
.inp{width:100%;padding:13px 16px;border-radius:12px;border:1.5px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.1);color:white;font-family:'Sora',sans-serif;font-size:13px;outline:none;margin-bottom:12px;}
.inp::placeholder{color:rgba(255,255,255,0.35);}
.login-btn{width:100%;padding:15px;background:white;color:var(--bd);border:none;border-radius:50px;font-family:'Sora',sans-serif;font-size:14px;font-weight:800;cursor:pointer;margin-top:4px;}

/* ══ HOME ══ */
.home-hdr{background:linear-gradient(135deg,var(--bdd),var(--bd));padding:16px 18px 14px;flex-shrink:0;}

/* WhatsApp banner — PROMINENT */
.wa-banner{background:linear-gradient(135deg,#075E54,#128C7E);border-radius:16px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:all .15s;}
.wa-banner:active{transform:scale(0.98);}
.wa-logo{width:44px;height:44px;background:var(--wa);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;box-shadow:0 4px 12px rgba(37,211,102,0.4);}
.wa-text h3{font-size:14px;font-weight:800;color:white;}
.wa-text p{font-size:11px;color:rgba(255,255,255,0.75);margin-top:2px;line-height:1.4;}
.wa-arrow{font-size:18px;color:rgba(255,255,255,0.6);margin-left:auto;}

.next-match{background:linear-gradient(135deg,var(--blue),var(--bd));border-radius:16px;padding:14px;margin-bottom:10px;position:relative;overflow:hidden;cursor:pointer;}
.nm-over{position:absolute;right:-10px;top:-10px;font-size:60px;opacity:0.1;}
.pts-chip{background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.15);border-radius:50px;padding:4px 12px;display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:white;margin-top:8px;}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;}
.qcard{background:white;border:1px solid var(--br);border-radius:14px;padding:12px;cursor:pointer;transition:all .15s;}
.qcard:active{transform:scale(0.97);background:var(--bl);}
.qcard-icon{font-size:22px;margin-bottom:5px;}
.qcard-title{font-size:12px;font-weight:700;color:var(--dk);}
.qcard-sub{font-size:10px;color:var(--md);margin-top:2px;}
.notif-bar{background:var(--al);border:1px solid #FAC775;border-radius:12px;padding:10px 14px;display:flex;gap:10px;align-items:center;margin-bottom:10px;cursor:pointer;}
.ig-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:2px;margin-bottom:4px;}
.ig-item{aspect-ratio:1;overflow:hidden;}
.ig-inner{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:28px;}

/* ══ PLANNING ══ */
.match-card{background:white;border:1px solid var(--br);border-radius:14px;padding:13px;margin-bottom:9px;cursor:pointer;}
.mc-row{display:flex;align-items:center;gap:12px;}
.mc-date{text-align:center;min-width:38px;}
.mc-day{font-size:9px;color:var(--md);text-transform:uppercase;}
.mc-num{font-size:22px;font-weight:800;color:var(--dk);line-height:1;}
.mc-mon{font-size:9px;color:var(--md);}

/* ══ MATCH DETAIL — DISPO ONLY ══ */
.match-hero{background:linear-gradient(135deg,var(--bdd),var(--blue));padding:20px 18px;flex-shrink:0;}
.back-btn{background:rgba(255,255,255,0.12);border:none;color:white;padding:5px 12px;border-radius:50px;font-size:11px;font-weight:600;cursor:pointer;font-family:'Sora',sans-serif;margin-bottom:10px;display:inline-block;}

.dispo-card{background:white;border:2px solid var(--br);border-radius:16px;padding:18px;margin-bottom:10px;cursor:pointer;transition:all .2s;text-align:center;}
.dispo-card.yes{border-color:var(--g);background:var(--gl);}
.dispo-card.no{border-color:var(--br);background:var(--lt);}
.dispo-icon{font-size:32px;margin-bottom:8px;}
.dispo-title{font-size:15px;font-weight:800;}
.dispo-sub{font-size:11px;color:var(--md);margin-top:4px;line-height:1.5;}

.poste-attribue{background:linear-gradient(135deg,var(--bd),var(--blue));border-radius:14px;padding:16px;text-align:center;}
.pa-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--bm);margin-bottom:6px;font-family:'JetBrains Mono',monospace;}
.pa-poste{font-size:22px;font-weight:800;color:white;margin-bottom:4px;}
.pa-sub{font-size:11px;color:var(--bm);}

.info-box{background:var(--bl);border:1px solid var(--bm);border-radius:12px;padding:12px 14px;margin-bottom:10px;}
.info-box h4{font-size:12px;font-weight:700;color:var(--bd);margin-bottom:5px;}
.info-box p{font-size:11px;color:var(--blue);line-height:1.6;}

.cobenevoles{background:var(--bl);border-radius:12px;padding:12px 14px;margin-bottom:10px;}
.cb-title{font-size:11px;font-weight:700;color:var(--bd);margin-bottom:8px;}
.cb-row{display:flex;gap:6px;align-items:center;}
.cb-av{width:28px;height:28px;font-size:9px;border:2px solid white;}

/* ══ POSTES ══ */
.poste-card{background:white;border:1px solid var(--br);border-radius:14px;padding:13px;margin-bottom:9px;cursor:pointer;display:flex;align-items:center;gap:12px;}
.pc-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.video-mock{background:var(--bdd);border-radius:14px;aspect-ratio:16/9;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;margin:10px 0;}
.video-mock::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(4,44,83,0.9),rgba(24,95,165,0.7));}
.yt-badge{position:absolute;top:8px;left:10px;background:rgba(255,0,0,0.9);border-radius:4px;padding:2px 7px;font-size:9px;color:white;font-weight:700;z-index:1;}
.play-btn{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,0.2);border:2px solid rgba(255,255,255,0.5);display:flex;align-items:center;justify-content:center;z-index:1;}
.play-tri{width:0;height:0;border-style:solid;border-width:8px 0 8px 14px;border-color:transparent transparent transparent white;margin-left:3px;}
.video-title{position:absolute;bottom:8px;left:10px;font-size:10px;color:rgba(255,255,255,0.7);z-index:1;}

/* ══ BOUTIQUE ══ */
.prod-card{background:white;border:1px solid var(--br);border-radius:14px;padding:12px;margin-bottom:9px;display:flex;align-items:center;gap:12px;}
.prod-img{width:52px;height:52px;border-radius:12px;background:var(--bl);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;}
.price-old{font-size:11px;color:var(--md);text-decoration:line-through;}
.price-new{font-size:14px;font-weight:800;color:var(--blue);}
.price-save{font-size:10px;background:var(--gl);color:var(--g);padding:1px 6px;border-radius:4px;font-weight:700;}
.add-btn{background:var(--blue);color:white;border:none;border-radius:50px;padding:7px 14px;font-family:'Sora',sans-serif;font-size:11px;font-weight:700;cursor:pointer;flex-shrink:0;}

/* ══ COMMUNAUTE ══ */
.comm-tabs{display:flex;gap:5px;padding:10px 18px;background:white;border-bottom:1px solid var(--br);flex-shrink:0;overflow-x:auto;}
.comm-tabs::-webkit-scrollbar{display:none;}
.post-card{background:white;border:1px solid var(--br);border-radius:14px;padding:13px;margin-bottom:9px;}
.emploi-card{background:white;border:1px solid var(--br);border-radius:14px;padding:14px;margin-bottom:9px;}
.ec-logo{width:40px;height:40px;border-radius:10px;background:var(--bl);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.minute-header{background:linear-gradient(135deg,#633806,var(--gold));border-radius:14px;padding:14px;margin-bottom:12px;display:flex;align-items:center;gap:12px;}

/* ══ PROFIL ══ */
.profil-hdr{background:linear-gradient(160deg,var(--bdd),var(--bd));padding:20px 18px;text-align:center;flex-shrink:0;}
.profil-av{width:68px;height:68px;font-size:22px;border:3px solid white;box-shadow:0 4px 16px rgba(0,0,0,0.3);margin:0 auto 8px;}
.stats-row{display:flex;gap:8px;padding:14px 18px;background:white;border-bottom:1px solid var(--br);flex-shrink:0;}
.stat-box{flex:1;text-align:center;}
.stat-val{font-size:22px;font-weight:800;color:var(--dk);font-family:'JetBrains Mono',monospace;}
.stat-lbl{font-size:9px;color:var(--md);margin-top:2px;}
.level-card{background:linear-gradient(135deg,var(--bdd),var(--bd));border-radius:14px;padding:14px;margin-bottom:10px;}
.badges-grid{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
.badge-item{text-align:center;width:56px;}
.badge-icon-wrap{width:48px;height:48px;border-radius:50%;background:var(--goldl);border:2px solid #F0C060;display:flex;align-items:center;justify-content:center;font-size:22px;margin:0 auto 4px;}
.badge-item.locked .badge-icon-wrap{background:var(--lt);border-color:var(--br);opacity:0.4;}
.info-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--lt);}
.info-row:last-child{border:none;}

/* ══ DASHBOARD ══ */
.dash-hdr{background:linear-gradient(135deg,#1a1a18,var(--bdd));padding:14px 18px;flex-shrink:0;}
.kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;}
.kpi{background:white;border:1px solid var(--br);border-radius:12px;padding:12px;text-align:center;}
.kpi-val{font-size:26px;font-weight:800;color:var(--dk);font-family:'JetBrains Mono',monospace;}
.kpi-lbl{font-size:10px;color:var(--md);margin-top:2px;}
.affectation-table{width:100%;border-collapse:collapse;font-size:11px;background:white;border-radius:12px;overflow:hidden;border:1px solid var(--br);}
.affectation-table th{background:var(--bdd);color:white;padding:8px 10px;text-align:left;font-size:10px;font-weight:700;}
.affectation-table td{padding:9px 10px;border-bottom:1px solid var(--lt);vertical-align:middle;}
.affectation-table tr:last-child td{border:none;}

/* Dashboard — affectation manuelle */
.benevole-slot{background:white;border:1px solid var(--br);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px;}
.slot-av{width:36px;height:36px;font-size:11px;flex-shrink:0;}
.slot-info{flex:1;}
.slot-name{font-size:12px;font-weight:700;color:var(--dk);}
.slot-exp{font-size:10px;color:var(--md);margin-top:1px;}
.slot-badges{display:flex;gap:4px;margin-top:4px;flex-wrap:wrap;}
.poste-assign-select{border:1.5px solid var(--br);border-radius:8px;padding:6px 10px;font-family:'Sora',sans-serif;font-size:11px;color:var(--dk);background:var(--bg);cursor:pointer;min-width:130px;}
.poste-assign-select.assigned{border-color:var(--g);background:var(--gl);color:var(--g);font-weight:700;}

.classement-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--lt);}
.classement-row:last-child{border:none;}

/* MODE SWITCH */
.mode-switch{position:fixed;bottom:20px;right:20px;background:white;border:2px solid var(--bdd);border-radius:50px;padding:8px 16px;font-family:'Sora',sans-serif;font-size:11px;font-weight:700;color:var(--bdd);cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,0.3);z-index:999;transition:all .2s;}

/* TOAST */
.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--dk);color:white;padding:10px 20px;border-radius:50px;font-size:12px;font-weight:600;font-family:'Sora',sans-serif;opacity:0;transition:opacity .3s;pointer-events:none;z-index:9999;white-space:nowrap;}
.toast.show{opacity:1;}
</style>
</head>
<body>

<div class="frame">
<div class="notch"><div class="notch-bar"></div></div>

<!-- ══ LOGIN ═══════════════════════════════════════════════════ -->
<div class="scr on" id="s-login" style="flex:1;">
  <div class="login-body">
    <div class="login-logo">🏐</div>
    <h1 style="font-size:26px;font-weight:800;color:white;text-align:center;margin-bottom:6px;">Spacers Bénévoles</h1>
    <p style="font-size:12px;color:var(--bm);text-align:center;margin-bottom:20px;line-height:1.5;">Votre espace bénévole · Saison 2026-2027</p>
    <input class="inp" type="email" placeholder="Email" value="sarah.dupont@gmail.com">
    <input class="inp" type="password" placeholder="Mot de passe" value="••••••••">
    <button class="login-btn" onclick="goScreen('s-ob1')" id="login-btn">Se connecter →</button>
    <div style="width:100%;height:1px;background:rgba(255,255,255,0.1);margin:16px 0;"></div>
    <div style="font-size:11px;color:rgba(181,212,244,0.5);text-align:center;margin-bottom:10px;">Pas encore de compte ?</div>
    <button style="width:100%;padding:12px;background:transparent;border:1.5px solid rgba(255,255,255,0.2);border-radius:50px;color:white;font-family:'Sora',sans-serif;font-size:13px;font-weight:600;cursor:pointer;" onclick="goScreen('s-profil-type')">Je découvre le bénévolat →</button>
    <div style="font-size:11px;color:rgba(181,212,244,0.4);text-align:center;margin-top:12px;cursor:pointer;">Mot de passe oublié ?</div>
  </div>
</div>


<!-- ══ CHOIX PROFIL ════════════════════════════════════════════ -->
<div class="scr" id="s-profil-type" style="flex:1;background:linear-gradient(160deg,var(--bdd),var(--bd));">
  <div style="flex:1;display:flex;flex-direction:column;padding:36px 24px 20px;">
    <button onclick="goScreen('s-login')" style="background:rgba(255,255,255,0.1);border:none;color:white;padding:6px 14px;border-radius:50px;font-size:11px;font-weight:600;cursor:pointer;font-family:'Sora',sans-serif;width:fit-content;margin-bottom:24px;">← Retour</button>
    <div style="font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--bm);margin-bottom:12px;font-family:monospace;">BIENVENUE CHEZ LES SPACERS</div>
    <h1 style="font-size:26px;font-weight:800;color:white;line-height:1.2;margin-bottom:8px;">Comment vous<br>décrivez-vous ?</h1>
    <p style="font-size:13px;color:rgba(181,212,244,0.7);margin-bottom:28px;line-height:1.6;">Cela nous aide à personnaliser votre expérience. Vous pouvez changer à tout moment.</p>

    <!-- Profil Hugo -->
    <div id="ptype-hugo" style="background:rgba(255,255,255,0.08);border:1.5px solid rgba(255,255,255,0.15);border-radius:16px;padding:16px;margin-bottom:12px;cursor:pointer;transition:all .2s;" onclick="selectProfil('hugo')">
      <div style="display:flex;align-items:center;gap:12px;">
        <div style="width:48px;height:48px;background:var(--blue);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;">⚡</div>
