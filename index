      <div class="classement-row"><div style="font-size:13px;font-weight:800;color:var(--gold);min-width:18px;">1</div><div class="av" style="width:30px;height:30px;font-size:10px;background:var(--g);">ML</div><div style="flex:1;"><div style="font-size:12px;font-weight:700;">Marie L.</div><div style="font-size:10px;color:var(--md);">11 matchs · 66h</div></div><div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gold);font-weight:600;">680 pts · 🥇</div></div>
      <div class="classement-row"><div style="font-size:13px;font-weight:800;color:var(--md);min-width:18px;">2</div><div class="av" style="width:30px;height:30px;font-size:10px;">TM</div><div style="flex:1;"><div style="font-size:12px;font-weight:700;">Thomas M.</div><div style="font-size:10px;color:var(--md);">9 matchs</div></div><div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gold);font-weight:600;">540 pts · 🥈</div></div>
      <div class="classement-row" style="border:none;"><div style="font-size:13px;font-weight:800;color:var(--md);min-width:18px;">3</div><div class="av" style="width:30px;height:30px;font-size:10px;background:var(--blue);">SD</div><div style="flex:1;"><div style="font-size:12px;font-weight:700;">Sarah D.</div><div style="font-size:10px;color:var(--md);">7 matchs</div></div><div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gold);font-weight:600;">420 pts · 🥉</div></div>
    </div>
  </div>
</div>

</div><!-- /frame -->

<!-- TOAST -->
<div class="toast" id="toast"></div>
<!-- MODE SWITCH -->
<div style="position:fixed;bottom:20px;right:20px;display:flex;flex-direction:column;gap:6px;z-index:999;">
  <button class="mode-switch" id="mode-btn" onclick="toggleDash()" style="font-size:10px;padding:7px 14px;">⚙️ Dashboard</button>
  <button style="background:linear-gradient(135deg,#C9821A,#854F0B);border:none;border-radius:50px;padding:7px 14px;font-family:'Sora',sans-serif;font-size:10px;font-weight:700;color:white;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,0.3);" onclick="goScreen('s-pilot')">🎯 Pilote match</button>
  <button style="background:linear-gradient(135deg,#1a1a18,#3B6D11);border:none;border-radius:50px;padding:7px 14px;font-family:'Sora',sans-serif;font-size:10px;font-weight:700;color:white;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,0.3);" onclick="goScreen('s-joel-simple')">🎖️ Espace Joël</button>
</div>

<script>
let isDash = false;

// ONBOARDING
let obPts = 50;
function skipTuto(){showScr('s-home');}
let selectedProfil = null;
function selectProfil(p){
  selectedProfil = p;
  ['hugo','virginie','joel'].forEach(x=>{
    const card = document.getElementById('ptype-'+x);
    const check = document.getElementById('pcheck-'+x);
    if(card) card.style.border = x===p ? '1.5px solid white' : '1.5px solid rgba(255,255,255,0.15)';
    if(check) { check.style.background = x===p ? 'white' : 'transparent'; check.style.borderColor = x===p ? 'white' : 'rgba(255,255,255,0.3)'; }
  });
  const btn = document.getElementById('ptype-btn');
  if(btn){ btn.style.opacity='1'; btn.style.pointerEvents='auto'; }
}
function launchProfil(){
  if(selectedProfil==='virginie') goScreen('s-vob1');
  else if(selectedProfil==='joel') goScreen('s-job1');
  else goScreen('s-ob1');
}
function finishTuto(){showScr('s-home');}
function obSelectDispo(c){
  document.getElementById('ob-yes').style.cssText='background:'+(c==='yes'?'var(--gl);border:2px solid var(--g)':'var(--lt);border:2px solid var(--br)')+';border-radius:10px;padding:10px;text-align:center;cursor:pointer;';
  document.getElementById('ob-no').style.cssText='background:'+(c==='no'?'var(--lt);border:2px solid var(--md)':'var(--lt);border:2px solid var(--br)')+';border-radius:10px;padding:10px;text-align:center;cursor:pointer;';
}
function obAddPts(v){
  obPts+=v;
  document.getElementById('ob-pts').textContent=obPts;
  const pct=Math.min((obPts/600)*100,100);
  document.getElementById('ob-prog').style.width=pct+'%';
  const lvl=document.getElementById('ob-level');
  const nxt=document.getElementById('ob-next');
  if(obPts>=1000){lvl.textContent='🥇 Or';nxt.textContent='Niveau maximum atteint !';document.getElementById('ob-prog').style.background='linear-gradient(90deg,#C9821A,#F5C842)';}
  else if(obPts>=600){lvl.textContent='🥈 Argent';nxt.textContent=(1000-obPts)+' pts avant Or';document.getElementById('ob-prog').style.background='linear-gradient(90deg,#6B7280,#A8B4C0)';}
  else{lvl.textContent='🥉 Bronze';nxt.textContent=(600-obPts)+' pts avant Argent';}
}

let dispoChoice = null;

function goApp(){isDash=false;showScr('s-home');document.getElementById('mode-btn').textContent='🎯 Vue Pilote';document.getElementById('mode-btn').style.cssText='background:white;color:var(--bdd);';}
function toggleDash(){isDash=!isDash;if(isDash){showScr('s-dash');document.getElementById('mode-btn').textContent='👤 Vue Bénévole';document.getElementById('mode-btn').style.cssText='background:var(--bdd);color:white;'}else{goApp();}}
function showScr(id){document.querySelectorAll('.scr').forEach(s=>s.classList.remove('on'));document.getElementById(id).classList.add('on');}
function goScreen(id){showScr(id);}
function navTo(tab){const m={home:'s-home',planning:'s-planning',postes:'s-postes',boutique:'s-boutique',communaute:'s-communaute',profil:'s-profil'};showScr(m[tab]);resetPostes();}
function switchComm(t){['forum','plans','emploi'].forEach(x=>{document.getElementById('ct-'+x).classList.toggle('on',x===t);document.getElementById('cc-'+x).style.display=x===t?'block':'none';});}

function selectDispo(choice){
  dispoChoice=choice;
  document.getElementById('dispo-yes').className='dispo-card'+(choice==='yes'?' yes':'');
  document.getElementById('dispo-no').className='dispo-card'+(choice==='no'?' no':'');
  const btn=document.getElementById('dispo-confirm-btn');
  btn.disabled=false;
  btn.style.background=choice==='yes'?'var(--g)':'var(--md)';
  btn.style.color='white';
  btn.textContent=choice==='yes'?'✅ Confirmer ma disponibilité':'Confirmer mon indisponibilité';
}

function confirmDispo(){
  if(!dispoChoice)return;
  const btn=document.getElementById('dispo-confirm-btn');
  btn.textContent=dispoChoice==='yes'?'✅ Disponibilité enregistrée !':'Réponse enregistrée — merci !';
  btn.disabled=true;
  setTimeout(()=>goScreen('s-planning'),1200);
}

function addCart(btn){btn.textContent='✓ Ajouté';btn.style.background='var(--g)';setTimeout(()=>{btn.textContent='Ajouter';btn.style.background='';},2000);}

function assignPoste(sel){
  if(sel.value&&sel.value!==''){sel.className='poste-assign-select assigned';showToast('Poste attribué · Notification envoyée ✓');}
}

function openPoste(icon,name,color,desc){
  document.getElementById('postes-list').style.display='none';
  const d=document.getElementById('poste-detail');
  d.style.display='block';
  d.innerHTML=`<button onclick="resetPostes()" style="background:none;border:none;font-size:12px;color:var(--blue);cursor:pointer;font-family:'Sora',sans-serif;padding:0;margin-bottom:12px;font-weight:600;">← Retour aux postes</button><div style="font-size:20px;font-weight:800;color:var(--dk);margin-bottom:12px;">${icon} ${name}</div><div class="video-mock"><div class="yt-badge">YouTube</div><div class="play-btn"><div class="play-tri"></div></div><div class="video-title">Formation — ${name}</div></div><div style="background:white;border:1px solid var(--br);border-radius:12px;padding:14px;font-size:12px;color:var(--md);line-height:1.7;margin-bottom:10px;">${desc}</div><div style="display:flex;gap:6px;flex-wrap:wrap;"><span class="badge b-gd">+50 pts par présence</span><span class="badge b-bl">Vidéo de formation disponible</span></div>`;
}

function resetPostes(){document.getElementById('postes-list').style.display='block';document.getElementById('poste-detail').style.display='none';}

function switchPilot(tab){
  ['checklist','equipe','memoire','feedback','urgence'].forEach(t=>{
    const btn=document.getElementById('pt-'+t);
    const panel=document.getElementById('pp-'+t);
    if(btn){btn.style.borderBottomColor=t===tab?'var(--blue)':'transparent';btn.style.color=t===tab?'var(--blue)':'var(--md)';btn.style.fontWeight=t===tab?'700':'600';}
    if(panel)panel.style.display=t===tab?'block':'none';
  });
}
function toggleCheck(el){
  el.classList.toggle('done');
}
function switchProfil(tab){
  ['profil','avantages','infos'].forEach(t=>{
    const btn=document.getElementById('ptab-'+t);
    const panel=document.getElementById('pp-'+t);
    if(btn){btn.style.borderBottomColor=t===tab?'var(--blue)':'transparent';btn.style.color=t===tab?'var(--blue)':'var(--md)';}
    if(panel)panel.style.display=t===tab?'block':'none';
  });
}
function filterFb(type){
  ['all','avis','idees','bugs'].forEach(t=>{
    const btn=document.getElementById('fb-'+t);
    if(btn){btn.classList.toggle('on',t===type);}
  });
  document.querySelectorAll('.fb-card').forEach(c=>{
    c.style.display=(type==='all'||c.dataset.type===type)?'block':'none';
  });
}
function voteIdee(btn){
  const n=parseInt(btn.textContent.replace('👍 ',''))+1;
  btn.textContent='👍 '+n;
  btn.style.background='var(--g)';btn.style.color='white';
  showToast('Vote enregistré ✓');
}
function markStatus(btn,status){
  btn.nextElementSibling.textContent=status;
  btn.nextElementSibling.style.color='var(--g)';
  btn.style.opacity='0.5';
  btn.style.pointerEvents='none';
  showToast(status+' enregistré ✓');
}
let starRating=0;
const starLabels=['','Décevant 😕','Peut mieux faire 🤔','Bien 👍','Très bien 😊','Excellent ! 🌟'];
function rateStar(n){
  starRating=n;
  for(let i=1;i<=5;i++){
    const s=document.getElementById('star'+i);
    if(s){s.textContent=i<=n?'★':'☆';s.style.color=i<=n?'#F5C842':'var(--br)';s.style.transform=i<=n?'scale(1.1)':'scale(1)';}
  }
  const lbl=document.getElementById('star-label');
  if(lbl)lbl.textContent=starLabels[n];
}
function toggleChip(el){el.classList.toggle('on');}
function toggleAnon(el){
  const check=document.getElementById('anon-check');
  const isOn=check.textContent==='✓';
  check.textContent=isOn?'':'✓';
  check.style.background=isOn?'white':'var(--blue)';
  check.style.borderColor=isOn?'var(--br)':'var(--blue)';
  check.style.color=isOn?'transparent':'white';
}
function submitFeedback(){
  if(starRating===0){showToast('Choisissez une note en étoiles');return;}
  showToast('Merci pour votre avis ! +10 pts crédités ✓');
  setTimeout(()=>goScreen('s-home'),1500);
}
function joelDispo(oui){
  const yo=document.getElementById('joel-oui');
  const no=document.getElementById('joel-non');
  if(oui){yo.style.background='var(--g)';yo.style.color='white';yo.style.borderColor='var(--g)';no.style.background='var(--lt)';no.style.color='var(--md)';no.style.borderColor='var(--br)';}
  else{no.style.background='var(--md)';no.style.color='white';no.style.borderColor='var(--md)';yo.style.background='var(--lt)';yo.style.color='var(--g)';yo.style.borderColor='var(--br)';}
  setTimeout(()=>showToast(oui?'✅ Disponibilité confirmée — Clément est notifié':'Réponse enregistrée — merci Joël !'),200);
}
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2500);}
</script>
</body>
</html>
